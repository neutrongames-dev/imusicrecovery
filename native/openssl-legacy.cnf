# OpenSSL 3 refuses the weak TLS a 2007-era device speaks (SHA-1 certs,
# 1024-bit RSA, TLS 1.0). libimobiledevice needs that handshake to talk to
# an iPhone OS 1.x-3.x lockdownd, so this config relaxes it INSIDE THE
# CONTAINER ONLY. Nothing on your PC is changed.
openssl_conf = openssl_init

[openssl_init]
ssl_conf = ssl_sect

[ssl_sect]
system_default = system_default_sect

[system_default_sect]
MinProtocol = TLSv1
MaxProtocol = TLSv1.3
CipherString = DEFAULT:@SECLEVEL=0
Options = UnsafeLegacyRenegotiation
