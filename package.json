{
  "name": "imusicrecovery-desktop",
  "productName": "iMusicRecovery",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "description": "Preservation-first Windows desktop recovery for music and video on legacy iPod touch devices.",
  "license": "MIT",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm-run-all --parallel dev:renderer dev:electron",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:electron": "wait-on http://127.0.0.1:5173 && cross-env VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .",
    "build": "vite build && tsc -p tsconfig.electron.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.electron.json --noEmit",
    "test": "node tests/run-tests.mjs",
    "verify": "npm run native:check && npm run typecheck && npm run build && npm run test",
    "native:check": "node scripts/check-native-safety.mjs",
    "dist:win": "npm run native:check && npm run build && electron-builder --win --x64",
    "dist:dir": "npm run native:check && npm run build && electron-builder --dir"
  },
  "devDependencies": {
    "@types/node": "24.3.0",
    "cross-env": "10.0.0",
    "electron": "44.1.1",
    "electron-builder": "26.15.3",
    "npm-run-all": "4.1.5",
    "typescript": "5.9.2",
    "vite": "7.1.4",
    "wait-on": "8.0.4"
  },
  "build": {
    "appId": "com.neutronstudios.imusicrecovery",
    "productName": "iMusicRecovery",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/native",
        "to": "native",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "iMusicRecovery",
      "deleteAppDataOnUninstall": false,
      "artifactName": "iMusicRecovery-Setup-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "iMusicRecovery-Portable-${version}-${arch}.${ext}"
    }
  },
  "engines": {
    "node": ">=24.18.0"
  },
  "author": "Neutron Studios"
}
